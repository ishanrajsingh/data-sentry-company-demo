# Local mode uses seeded in-memory data when MONGODB_URI is empty.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=data_sentry_company_demo

# Required for real model review and answer generation. Never commit a real key.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MODEL=openai/gpt-oss-20b

# Use a random secret outside local demos. Keep the same value across backend restarts.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUDIT_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Use false for local HTTP; set true in Railway behind the Vercel rewrite.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5180,http://127.0.0.1:5180

ALLOW_DEMO_CREDENTIALS=true

# Optional overrides for the synthetic demo accounts.
DEMO_PASSWORD_GUEST=Northstar-Guest-26
DEMO_PASSWORD_EMPLOYEE=Northstar-Employee-26
DEMO_PASSWORD_MANAGER=Northstar-Manager-26
DEMO_PASSWORD_SUPPORT=Northstar-Support-26
DEMO_PASSWORD_HR=Northstar-HR-26
DEMO_PASSWORD_EXECUTIVE=Northstar-Executive-26
DEMO_PASSWORD_SECURITY_ADMIN=Northstar-Security-26
DEMO_PASSWORD_EMPLOYEE_B=Northstar-Employee-B-26
DEMO_PASSWORD_EMPLOYEE_C=Northstar-Employee-C-26
DEMO_PASSWORD_ADMIN=Northstar-Admin-26
